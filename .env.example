# Downstream (Play4CashApi)
DOWNSTREAM_URL=http://localhost:3000

# Gateway port
PORT=4000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (must match Play4CashApi)
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=play4cash-api
JWT_AUDIENCE=play4cash-clients

# Token prefix in Redis (must match API: accessTokens:)
REDIS_TOKEN_PREFIX=accessTokens:

# Comma-separated exact paths that skip auth (override only if API public routes change)
# PUBLIC_API_PATHS=/api/login,...

# Set true only if legacy clients send ?token= on REST (discouraged)
ALLOW_HTTP_TOKEN_QUERY=false

# Same values as API GATEWAY_INTERNAL_SECRET / GATEWAY_TRUST_HEADER_NAME so the API trusts x-gateway-user
GATEWAY_INTERNAL_SECRET=
GATEWAY_TRUST_HEADER_NAME=x-gateway-internal

# CORS origins (comma-separated). Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3001,http://localhost:4200
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=50

# PWA forced upgrade (WebSocket gate). Should match the API's PWA_MIN_VERSION.
# When set (e.g. "1.2.0"), WS handshakes from clients reporting a lower X-App-Version /
# auth.appVersion are rejected with `version_mismatch`. Empty disables the check.
PWA_MIN_VERSION=
