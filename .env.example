# Downstream (Play4CashApi)
DOWNSTREAM_URL=http://localhost:3000

# Gateway port
PORT=4000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here

# Token prefix in Redis
REDIS_TOKEN_PREFIX=accessTokens:

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:4200
