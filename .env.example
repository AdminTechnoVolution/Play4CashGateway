# APP SERVICE DEL GATEWAY
# Valores vacíos: completar con tus datos. No subir secretos reales a Git.
# Azure proporciona PORT. No necesita credenciales NOWPayments.

# VALORES LISTOS PARA COPIAR
NODE_ENV=production
JWT_ISSUER=play4cash-api
JWT_AUDIENCE=play4cash-clients
REDIS_TOKEN_PREFIX=accessTokens:
ADMIN_JWT_ISSUER=play4cash-api
ADMIN_JWT_AUDIENCE=play4cash-admin
ADMIN_REDIS_ACCESS_PREFIX=admin:accessTokens:

# Comma-separated exact paths that skip auth (override only if API public routes change)
# Default also includes /api/admin/auth/login, /refresh and /invalidate-browser-session.
# PUBLIC_API_PATHS=/api/login,...

# Test-only login bypass — must match the API's own ENABLE_FAKE_LOGIN exactly, or
# /api/login/fake will be rejected here (401) or 404 on the API, either way failing
# closed. Also requires NODE_ENV != production; hard-blocked there regardless.
ENABLE_FAKE_LOGIN=false

# Set true only if legacy clients send ?token= on REST (discouraged)
ALLOW_HTTP_TOKEN_QUERY=false

# Same values as API GATEWAY_INTERNAL_SECRET / GATEWAY_TRUST_HEADER_NAME so the API trusts x-gateway-user
GATEWAY_INTERNAL_SECRET=
GATEWAY_TRUST_HEADER_NAME=x-gateway-internal
ENABLE_FAKE_LOGIN=false
ALLOW_HTTP_TOKEN_QUERY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=50
WS_TOKEN_REVALIDATE_MS=300000

# Per-player (not per-IP) cap on inbound WebSocket events forwarded to the API,
# so one session can't flood the backend/Redis with game-action spam. Window
# minimum 1000ms; defaults: 30 events per 10000ms.
WS_EVENT_RATE_LIMIT_MAX=30
WS_EVENT_RATE_LIMIT_WINDOW_MS=10000

REDIS_HOST=

WS_EVENT_RATE_LIMIT_MAX=30
WS_EVENT_RATE_LIMIT_WINDOW_MS=10000

# TUS DATOS: completar antes de desplegar
# Dirección interna o HTTPS del App Service de la API, no del worker ni de la PWA.
DOWNSTREAM_URL=
# Copiar exactamente REDIS_URI de la API (incluido rediss:// si usa TLS).
# No dejar un REDIS_URL antiguo con otro valor: tiene prioridad en el código.
REDIS_URI=
# Copiar JWT_SECRET_KEY de la API en este nombre distinto.
JWT_SECRET=
# Copiar ADMIN_JWT_SECRET_KEY de la API.
ADMIN_JWT_SECRET_KEY=
# Copiar GATEWAY_INTERNAL_SECRET de la API.
GATEWAY_INTERNAL_SECRET=
# Dominios HTTPS de PWA y Admin, separados por comas, sin rutas.
CORS_ORIGINS=

